@startuml
title Диаграмма классов «Такси»
skinparam dpi 130
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
skinparam classAttributeIconSize 0

abstract class Пользователь {
  # код: Строка
  # имя: Строка
  # телефон: Строка
  # почта: Строка
  --
  + войти(): Логическое
  + выйти()
}

class Пассажир {
  - бонусныйБаланс: Дробное
  - рейтинг: Дробное
  --
  + создатьЗаказ(): Заказ
  + отменитьЗаказ(): Логическое
  + оценитьВодителя(): Отзыв
}

class Водитель {
  - номерПрав: Строка
  - статус: СтатусВодителя
  - рейтинг: Дробное
  --
  + выйтиНаЛинию()
  + принятьЗаказ(): Логическое
  + завершитьПоездку()
}

class Оператор {
  - табельныйНомер: Строка
  --
  + обработатьОбращение()
}

class Администратор {
  - кодАдминистратора: Строка
  --
  + управлятьТарифами()
  + заблокироватьАккаунт()
  + проверитьВодителя(): Логическое
}

class Автомобиль {
  - госНомер: Строка
  - модель: Строка
  - цвет: Строка
  - классАвто: Строка
}

class Заказ {
  - номер: Строка
  - адресПодачи: Строка
  - адресНазначения: Строка
  - статус: СтатусЗаказа
  - времяСоздания: Дата
  --
  + рассчитатьЦену(): Дробное
  + назначитьВодителя()
  + отменить(): Дробное
}

class Поездка {
  - началоПоездки: Дата
  - конецПоездки: Дата
  - расстояниеКм: Дробное
  - итоговаяЦена: Дробное
  --
  + завершить()
}

class Тариф {
  - название: Строка
  - базоваяЦена: Дробное
  - ценаЗаКм: Дробное
  - ценаЗаМинуту: Дробное
  --
  + рассчитать(км: Дробное, мин: Целое): Дробное
}

class Платёж {
  - номер: Строка
  - сумма: Дробное
  - способ: Строка
  - оплачен: Логическое
  --
  + провести(): Логическое
}

class Отзыв {
  - оценка: Целое
  - комментарий: Строка
}

class Обращение {
  - текст: Строка
  - статус: Строка
}

class "Платёжная система" as ПлатёжнаяСистема <<внешняя система>> {
  + списать(сумма: Дробное): Логическое
}

class "Картографический сервис" as КартографическийСервис <<внешняя система>> {
  + построитьМаршрут(): Маршрут
}

enum СтатусЗаказа {
  ПОИСК_ВОДИТЕЛЯ
  ВОДИТЕЛЬ_НАЗНАЧЕН
  В_ПУТИ
  ЗАВЕРШЁН
  ОТМЕНЁН
}

enum СтатусВодителя {
  НЕ_НА_ЛИНИИ
  НА_ЛИНИИ
  ЗАНЯТ
}

' Наследование
Пользователь <|-- Пассажир
Пользователь <|-- Водитель
Пользователь <|-- Оператор
Пользователь <|-- Администратор

' Ассоциации
Пассажир "1" -- "0..*" Заказ : создаёт
Водитель "0..1" -- "0..*" Заказ : выполняет
Водитель "1" -- "1..*" Автомобиль : управляет
Заказ "0..*" -- "1" Тариф : рассчитывается по
Пассажир "1" -- "0..*" Отзыв : оставляет
Отзыв "0..*" -- "1" Водитель : о водителе
Пользователь "1" -- "0..*" Обращение : создаёт
Оператор "1" -- "0..*" Обращение : обрабатывает
Администратор ..> Тариф : управляет
Администратор ..> Водитель : проверяет

' Композиция и агрегация
Заказ "1" *-- "0..1" Поездка : порождает
Поездка "1" o-- "0..1" Платёж : оплачивается

' Внешние системы
Платёж ..> ПлатёжнаяСистема : использует
Заказ ..> КартографическийСервис : использует

' Перечисления
Заказ --> СтатусЗаказа
Водитель --> СтатусВодителя

note right of Заказ
  **Бизнес-правила:**
  - Отмена до назначения водителя бесплатна
  - Отмена после назначения: штраф
  - Водитель отвечает на заказ 15 секунд
end note
@enduml
