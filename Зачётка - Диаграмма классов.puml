@startuml
title Диаграмма классов «Университет / Электронная зачётка»
skinparam dpi 130
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
skinparam classAttributeIconSize 0

abstract class Пользователь {
  # код: Строка
  # фио: Строка
  # почта: Строка
  --
  + войти(): Логическое
  + выйти()
}

class Студент {
  - номерСтудента: Строка
  - курс: Целое
  --
  + посмотретьОценки(): Список<Оценка>
  + записатьсяНаПересдачу(): Логическое
  + запроситьВыписку(): Строка
}

class Преподаватель {
  - табельныйНомер: Строка
  - должность: Строка
  --
  + выставитьОценку(): Логическое
  + создатьВедомость(): Ведомость
}

class СотрудникДеканата {
  - табельныйНомер: Строка
  --
  + управлятьГруппами()
  + спланироватьСессию()
  + закрытьВедомость(): Логическое
}

class Администратор {
  - кодАдминистратора: Строка
  --
  + создатьАккаунт(): Пользователь
  + заблокироватьАккаунт()
}

class Группа {
  - код: Строка
  - название: Строка
  - годПоступления: Целое
  --
  + добавитьСтудента()
}

class Дисциплина {
  - код: Строка
  - название: Строка
  - часы: Целое
  - формаКонтроля: ФормаКонтроля
}

class ЗачётнаяКнижка {
  - номер: Строка
  - датаВыдачи: Дата
  --
  + получитьОценки(): Список<Оценка>
  + среднийБалл(): Дробное
}

class Оценка {
  - значение: Строка
  - дата: Дата
  --
  + сдано(): Логическое
}

class Ведомость {
  - номер: Строка
  - дата: Дата
  - статус: СтатусВедомости
  --
  + добавитьОценку()
  + закрыть()
}

class РасписаниеЭкзамена {
  - дата: Дата
  - время: Строка
  - аудитория: Строка
}

class Пересдача {
  - дата: Дата
  - аудитория: Строка
  - номерПопытки: Целое
  --
  + записать(): Логическое
}

class "Сервис уведомлений" as СервисУведомлений <<внешняя система>> {
  + отправить(сообщение: Строка)
}

enum ФормаКонтроля {
  ЭКЗАМЕН
  ЗАЧЁТ
  ДИФФ_ЗАЧЁТ
}

enum СтатусВедомости {
  ОТКРЫТА
  ЗАКРЫТА
}

' Наследование
Пользователь <|-- Студент
Пользователь <|-- Преподаватель
Пользователь <|-- СотрудникДеканата
Пользователь <|-- Администратор

' Композиция и агрегация
Студент "1" *-- "1" ЗачётнаяКнижка : имеет
ЗачётнаяКнижка "1" *-- "0..*" Оценка : содержит
Группа "1" o-- "1..*" Студент : состоит из
Ведомость "1" o-- "0..*" Оценка : включает

' Ассоциации
Оценка "0..*" -- "1" Дисциплина : по дисциплине
Преподаватель "1..*" -- "0..*" Дисциплина : преподаёт
Преподаватель "1" -- "0..*" Ведомость : формирует
Ведомость "0..*" -- "1" Дисциплина : по дисциплине
Ведомость "0..*" -- "1" Группа : для группы
Студент "1" -- "0..*" Пересдача : записан на
Пересдача "0..*" -- "1" Дисциплина : по дисциплине
Дисциплина "1" -- "0..*" РасписаниеЭкзамена : назначена в

' Зависимости
СотрудникДеканата ..> Ведомость : закрывает
СотрудникДеканата ..> РасписаниеЭкзамена : формирует
Администратор ..> Пользователь : управляет аккаунтами
Оценка ..> СервисУведомлений : уведомление студенту

' Перечисления
Дисциплина --> ФормаКонтроля
Ведомость --> СтатусВедомости

note right of Пересдача
  **Бизнес-правила:**
  - Не более 3 попыток пересдачи
  - Запись только при наличии задолженности
  - Оценку вносит преподаватель
end note
@enduml
